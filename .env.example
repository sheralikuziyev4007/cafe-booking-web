# Copy this file to .env.local and fill in the values.
#
# Leave both empty to run the self-contained demo: data stays in this browser (localStorage)
# and the admin panel login is admin / admin123.
#
# Set both to use a real Supabase backend (see "Connect a backend" in README.md).
# The anon key is public by design: access is limited by Row Level Security (supabase/schema.sql).
# Never put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
